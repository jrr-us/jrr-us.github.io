{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}


  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>

  <footer class="sticky-bottom mt-0 bg-dark" role="contentinfo">
    <div class="container py-1">
      <div class="row justify-content-center">
        <div class="col-4 col-sm-3 align-self-center">
          <a href="https://www.us.es">
            {% include figure.liquid path="assets/img/logos/us.png" title="University of Seville" %}
          </a>
        </div>
        <div class="col-4 col-sm-3 align-self-center">
          <a href="https://www.csic.es">
            {% include figure.liquid path="assets/img/logos/csic.png" title="CSIC" %}
          </a>
        </div>
        <div class="col-4 col-sm-2 align-self-end">
          <a href="https://www.juntadeandalucia.es">
            {% include figure.liquid path="assets/img/logos/junta.png" title="Junta de Andalucía" %}
          </a>
        </div>
      </div>
    </div>
  </footer>

