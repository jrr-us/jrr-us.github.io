@article{solchenbachElectrolyteMotionInduced2024,
  title = {Electrolyte Motion Induced Salt Inhomogeneity - a Novel Aging Mechanism in Large-Format Lithium-Ion Cells},
  author = {Solchenbach, S. and Tacconis, C. and {Gómez-Martín}, A. and Peters, V. and Wallisch, L. and Stanke, A. and Hofer, J. and Renz, D. and Lewerich, B. and Bauer, G. and Wichmann, M. and Goldbach, D. and Adam, A. and Spielbauer, M. and Lamp, P. and Wandt, J.},
  year = 2024,
  journal = {Energy and Environmental Science},
  volume = {17},
  number = {19},
  pages = {7294--7317},
  doi = {10.1039/d4ee03211j},
  abstract = {The electrification of the transport sector places ever-increasing demands on the energy density, fast-charging performance, and lifetime of lithium-ion cells. In this study, we investigate fast-charging of high energy density (∼ 800 W h L−1) prototype cylindrical 4695 lithium-ion cells with two different (“low” and “high”) electrolyte amounts. Using pore volume calculations, computer tomography and moment of inertia measurements, we find that the volume change of the active material causes electrolyte motion into and out of the jelly roll upon cycling in the high electrolyte cells, while no electrolyte motion occurs in the low electrolyte cells. At the same time, the high electrolyte cells show a significantly worse capacity retention during fast charge cycling compared to the low electrolyte cells (24\% vs. 5\% capacity loss after 130 cycles). We demonstrate that a coupling of in-plane electrolyte motion with the through-plane LiPF{$<$}inf{$>$}6{$<$}/inf{$>$} concentration gradient rapidly causes a strong LiPF{$<$}inf{$>$}6{$<$}/inf{$>$} concentration gradient along the jelly roll height (= in-plane) on a cm-scale: after only 18 cycles, LiPF{$<$}inf{$>$}6{$<$}/inf{$>$} concentrations at the jelly roll edges and center (as determined by ion-chromatography) deviate by more than ± 50\% in comparison to the initial average value. We term this hitherto unknown effect “electrolyte motion induced salt inhomogeneity” (EMSI). This long-scale salt concentration gradient causes a loss of cell capacity, an increase in resistance, and eventually highly localized lithium plating. Finally, we discuss the far-reaching implications of the EMSI effect on cell design and testing, not only for cylindrical cells but any large-format lithium-ion cell under high compression. © 2024 The Royal Society of Chemistry.},
  keywords = {Aging mechanism,Compression testing,Concentration- gradients,electrification,electrolyte,Electrolyte cells,Electrolytes,Energy density,Fast charging,Fast charging (Batteries),inertia,Inhomogeneities,inhomogeneity,Ion chromatography,ion exchange,Large-format,LiPF 6,lithium,Lithium-ion cells,Medical imaging,tomography,Transport sectors}
}

@article{gomez-martinOpportunitiesChallengesLi2C4O42022,
  title = {Opportunities and {{Challenges}} of {{Li2C4O4}} as {{Pre-Lithiation Additive}} for the {{Positive Electrode}} in {{NMC622}}||{{Silicon}}/{{Graphite Lithium Ion Cells}}},
  author = {{Gómez-Martín}, A. and Gnutzmann, M.M. and Adhitama, E. and Frankenstein, L. and Heidrich, B. and Winter, M. and Placke, T.},
  year = 2022,
  journal = {Advanced Science},
  volume = {9},
  number = {24},
  doi = {10.1002/advs.202201742},
  abstract = {Silicon (Si)-based negative electrodes have attracted much attention to increase the energy density of lithium ion batteries (LIBs) but suffer from severe volume changes, leading to continuous re-formation of the solid electrolyte interphase and consumption of active lithium. The pre-lithiation approach with the help of positive electrode additives has emerged as a highly appealing strategy to decrease the loss of active lithium in Si-based LIB full-cells and enable their practical implementation. Here, the use of lithium squarate (Li{$<$}inf{$>$}2{$<$}/inf{$>$}C{$<$}inf{$>$}4{$<$}/inf{$>$}O{$<$}inf{$>$}4{$<$}/inf{$>$}) as low-cost and air-stable pre-lithiation additive for a LiNi{$<$}inf{$>$}0.6{$<$}/inf{$>$}Mn{$<$}inf{$>$}0.2{$<$}/inf{$>$}Co{$<$}inf{$>$}0.2{$<$}/inf{$>$}O{$<$}inf{$>$}2{$<$}/inf{$>$} (NMC622)-based positive electrode is investigated. The effect of additive oxidation on the electrode morphology and cell electrochemical properties is systematically evaluated. An increase in cycle life of NMC622||Si/graphite full-cells is reported, which grows linearly with the initial amount of Li{$<$}inf{$>$}2{$<$}/inf{$>$}C{$<$}inf{$>$}4{$<$}/inf{$>$}O{$<$}inf{$>$}4{$<$}/inf{$>$}, due to the extra Li+ ions provided by the additive in the first charge. Post mortem investigations of the cathode electrolyte interphase also reveal significant compositional changes and an increased occurrence of carbonates and oxidized carbon species. This study not only demonstrates the advantages of this pre-lithiation approach but also features potential limitations for its practical application arising from the emerging porosity and gas development during decomposition of the pre-lithiation additive. © 2022 The Authors. Advanced Science published by Wiley-VCH GmbH.},
  keywords = {Active lithium loss,active lithium losses,Additives,Cathode additive,cathode additives,Cathodes,Cobalt compounds,Electrochemical electrodes,Energy density,Ions,Lithium compounds,lithium ion batteries,Lithium-ion batteries,Lithium-ion cells,Manganese compounds,Negative electrode,Nickel compounds,Positive electrodes,pre-lithiation,Pre-lithiation,silicon,Silicon,Silicon-based,Solid electrolyte interphase,Solid electrolytes,Volume change}
}

@article{gomez-martinMagnesiumSubstitutionNiRich2022,
  title = {Magnesium {{Substitution}} in {{Ni-Rich NMC Layered Cathodes}} for {{High-Energy Lithium Ion Batteries}}},
  author = {{Gómez-Martín}, A. and Reissig, F. and Frankenstein, L. and Heidbuchel, M. and Winter, M. and Placke, T. and Schmuch, R.},
  year = 2022,
  journal = {Advanced Energy Materials},
  volume = {12},
  number = {8},
  doi = {10.1002/aenm.202103045},
  abstract = {Ni-rich LiNi{$<$}inf{$>$}1−{$<$}/inf{$><$}inf{$>$}x{$<$}/inf{$><$}inf{$>$}−{$<$}/inf{$><$}inf{$>$}y{$<$}/inf{$>$}Mn{$<$}inf{$>$}x{$<$}/inf{$>$}Co{$<$}inf{$>$}y{$<$}/inf{$>$}O{$<$}inf{$>$}2{$<$}/inf{$>$} (NMC) layered oxides are promising cathode materials for high-energy density lithium ion batteries but suffer from severe capacity fading upon cycling. Elemental substitution (= doping) with Mg has repeatedly attracted attention in NMC materials to overcome instability problems at reasonable cost, yet rational compositional tuning is needed to guarantee sufficient cycle life without compromising energy density on the material level. Herein, a series of Mg-substituted NMC materials with 90 mol\% Ni are investigated regarding key performance metrics in NMC || graphite full-cells benchmarked against LiNi{$<$}inf{$>$}0.80{$<$}/inf{$>$}Mn{$<$}inf{$>$}0.10{$<$}/inf{$>$}Co{$<$}inf{$>$}0.10{$<$}/inf{$>$}O{$<$}inf{$>$}2{$<$}/inf{$>$} and LiNi{$<$}inf{$>$}0.90{$<$}/inf{$>$}Mn{$<$}inf{$>$}0.05{$<$}/inf{$>$}Co{$<$}inf{$>$}0.05{$<$}/inf{$>$}O{$<$}inf{$>$}2{$<$}/inf{$>$} synthetized using the same co-precipitation route. A linear correlation between cycle life and attainable gravimetric capacities is demonstrated, which are directly influenced by the degree of Mg substitution and the amount of Li+ cycled upon (de-)lithiation processes. A Mg content {$<$}2 mol\% should be considered to take notable benefit from the increase in Ni content from 80 to 90 mol\% to achieve a higher energy density. The present study highlights the importance of evaluating the true implications of elemental substitution on cell performance and is expected to be an insightful guideline for the future development of NMC-type cathode materials in particular with high Ni and low Co content. © 2022 The Authors.},
  keywords = {Advanced energy materials,Capacity fading,cathode materials,Cathodes,Charging (batteries),Cycle lives,Energy,Higher energy density,Instability problems,Layered cathode,Layered oxides,Lithium compounds,lithium ion batteries,Lithium-ion batteries,low-cobalt cathodes,Magnesium,Magnesium substitution,Manganese compounds,Mg substitution,Nickel,Nickel compounds,nickel-rich layered oxides,Substitution doping}
}

@article{gomez-martinCorrelationStructurePerformance2019,
  title = {Correlation of {{Structure}} and {{Performance}} of {{Hard Carbons}} as {{Anodes}} for {{Sodium Ion Batteries}}},
  author = {{Gomez-Martin}, Aurora and {Martinez-Fernandez}, Julian and Ruttert, Mirco and Winter, Martin and Placke, Tobias and {Ramirez-Rico}, Joaquin},
  year = 2019,
  journal = {Chemistry of Materials},
  volume = {31},
  number = {18},
  pages = {7288--7299},
  publisher = {American Chemical Society},
  issn = {0897-4756},
  doi = {10.1021/acs.chemmater.9b01768},
  urldate = {2025-11-18},
  abstract = {Hard carbons are the material of choice as negative electrode in sodium ion batteries. Despite being extensively studied, there is still debate regarding the mechanisms responsible for storage in low- and high-potential regions. This work presents a comprehensive approach to elucidate the involved storage mechanisms when Na ions insert into such disordered structures. Synchrotron X-ray total scattering experiments were performed to access quantitative information on atomic ordering in these materials at the nanoscale. Results prove that hard carbons undergo an atomic rearrangement as the graphene layers cross-link at intermediate temperatures (1200–1600 °C), resulting in an increase of the average interplanar distance up to 1400 °C, followed by a progressive decrease. This increase correlates with the positive trend in the reversible capacity of biomass-derived carbons when processed up to 1200–1600 °C due to an increased capacity at low potential (≤0.1 V vs Na/Na+). A decrease in achievable sloping capacity with increasing heat-treatment temperature arises from larger crystalline domains and a lower concentration of defects. The observed correlation between structural parameters and electrochemical properties clearly supports that the main storage of Na ions into a hard-carbon structure is based on an adsorption–intercalation mechanism.},
  keywords = {Atomic rearrangements,Disordered structures,Electrodes,Heat treatment temperature,Intercalation mechanisms,Intermediate temperatures,Metal ions,Quantitative information,Sodium-ion batteries,Storage (materials),Structural parameter,Structure and performance}
}

@article{gomez-martinIronCatalyzedGraphiticCarbon2018,
  title = {Iron-{{Catalyzed Graphitic Carbon Materials}} from {{Biomass Resources}} as {{Anodes}} for {{Lithium-Ion Batteries}}},
  author = {{Gomez-Martin}, Aurora and {Martinez-Fernandez}, Julian and Ruttert, Mirco and Heckmann, Andreas and Winter, Martin and Placke, Tobias and {Ramirez-Rico}, Joaquin},
  year = 2018,
  journal = {ChemSusChem},
  volume = {11},
  number = {16},
  pages = {2776--2787},
  issn = {1864-564X},
  doi = {10.1002/cssc.201800831},
  urldate = {2025-01-19},
  abstract = {Graphitized carbon materials from biomass resources were successfully synthesized with an iron catalyst, and their electrochemical performance as anode materials for lithium-ion batteries (LIBs) was investigated. Peak pyrolysis temperatures between 850 and 2000 °C were covered to study the effect of crystallinity and microstructural parameters on the anodic behavior, with a focus on the first-cycle Coulombic efficiency, reversible specific capacity, and rate performance. In terms of capacity, results at the highest temperatures are comparable to those of commercially used synthetic graphite derived from a petroleum coke precursor at higher temperatures, and up to twice as much as that of uncatalyzed biomass-derived carbons. The opportunity to graphitize low-cost biomass resources at moderate temperatures through this one-step environmentally friendly process, and the positive effects on the specific capacity, make it interesting to develop more sustainable graphite-based anodes for LIBs.},
  copyright = {© 2018 Wiley-VCH Verlag GmbH \& Co. KGaA, Weinheim},
  langid = {english},
  keywords = {Anodes,biomass,Biomass,carbon,Carbon,Catalysts,Coulombic efficiency,Electrochemical performance,electrochemistry,Electrochemistry,Environmentally friendly process,graphite,Graphite,Highest temperature,iron,Iron,Lithium-ion batteries,Microstructural parameters,Moderate temperature,Petroleum coke,Pyrolysis temperature,Reversible specific capacity}
}
