@article{guzman-puyolGreaseproofHydrophobicBiodegradable2022,
  title = {Greaseproof, Hydrophobic, and Biodegradable Food Packaging Bioplastics from {{C6-fluorinated}} Cellulose Esters},
  author = {{Guzman-Puyol}, S. and Tedeschi, G. and Goldoni, L. and Benítez, J.J. and Ceseracciu, L. and Koschella, A. and Heinze, T. and Athanassiou, A. and {Heredia-Guerrero}, J.A.},
  year = 2022,
  journal = {Food Hydrocolloids},
  volume = {128},
  doi = {10.1016/j.foodhyd.2022.107562},
  abstract = {Tridecafluorononanoic acid (TFNA), a C6-fluorinated carboxylic acid, was esterified with cellulose at different molar ratios (0:1, 1:1, 2:1, and 3:1) in a trifluoroacetic acid (TFA):trifluoroacetic anhydride (TFAA):CHCl{$<$}inf{$>$}3{$<$}/inf{$>$} (2:1:1, v:v:v) solvent mixture. Free-standing films were obtained for all formulations and are presented as alternatives to composites and blends of paper with fluorinated molecules. Mechanical properties were investigated by tensile tests, and a plasticizer effect of fluorinated chains was observed. Interestingly, the wettability of these new cellulose derivatives was similar or even better than other common cellulose derivatives and fluorinated polymers employed in food packaging. Hydrodynamic properties were also improved by addition of TFNA, resulting in materials with water vapor permeability values comparable to other cellulose-based food packaging materials. In addition, films with the higher amounts of TFNA showed the required oil resistance for papers used in food packaging applications, as determined by the Kit Test. Finally, the biodegradation of these C6-fluorinated cellulose esters, assessed by biological oxygen demand (BOD) in seawater, was higher than typical bio-based polymers used in food packaging. The bioplastic synthesized at a molar ratio 1:1 (TFNA:cellulose) showed excellent performances in terms of greaseproof, hydrophobicity, ductility, and biodegradability, representing a sustainable alternative to typical plastics used in food packaging. © 2022 The Authors},
  keywords = {Bio-based,Bio-based plastic,Bio-based plastics,Bio-plastics,Biochemical oxygen demand,Biodegradability,Biodegradable polymers,Biodegradation,C6-fluorinated carboxylic acid,Carboxylic acids,Cellulose,Cellulose -derivatives,Cellulose esters,Elastomers,Esters,Food packaging,Greaseproof,Greaseproof paper,Greaseproof papers,Hydrophobicity,Molar ratio,Oils and fats,Oxygen,Packaging,Packaging machines,Packaging materials,Polyethylenes,Reinforced plastics,Tensile testing}
}

@article{guzman-puyolPectinlipidSelfassemblyInfluence2015,
  title = {Pectin-Lipid Self-Assembly: {{Influence}} on the Formation of Polyhydroxy Fatty Acids Nanoparticles},
  author = {{Guzman-Puyol}, S. and Benítez, J.J. and Domínguez, E. and Bayer, I.S. and Cingolani, R. and Athanassiou, A. and Heredia, A. and {Heredia-Guerrero}, J.A.},
  year = 2015,
  journal = {PLoS ONE},
  volume = {10},
  number = {4},
  doi = {10.1371/journal.pone.0124639},
  abstract = {Nanoparticles, named cutinsomes, have been prepared from aleuritic (9,10,16-trihidroxipalmitic) acid and tomato fruit cutin monomers (a mixture of mainly 9(10),16-dihydroxypalmitic acid (85\%, w/w) and 16-hydroxyhexadecanoic acid (7.5\%, w/w)) with pectin in aqueous solution. The process of formation of the nanoparticles of aleuritic acid plus pectin has been monitored by UV-Vis spectrophotometry, while their chemical and morphological characterization was analyzed by ATR-FTIR, TEM, and non-contact AFM. The structure of these nanoparticles can be described as a lipid core with a pectin shell. Pectin facilitated the formation of nanoparticles, by inducing their aggregation in branched chains and favoring the condensation between lipid monomers. Also, pectin determined the self-assembly of cutinsomes on highly ordered pyrolytic graphite (HOPG) surfaces, causing their opening and forming interconnected structures. In the case of cutin monomers, the nanoparticles are fused, and the condensation of the hydroxy fatty acids is strongly affected by the presence of the polysaccharide. The interaction of pectin with polyhydroxylated fatty acids could be related to an initial step in the formation of the plant biopolyester cutin. © 2015 Guzman-Puyol et al.},
  keywords = {aleuritic acid nanoparticle,aleuritolic acid,Article,atomic force microscopy,attenuated total reflected fourier transform infrared spectroscopy,chemistry,controlled study,cutin,esterification,Esterification,fatty acid,Fatty Acids,graphite,hydroxy fatty acid,infrared spectroscopy,lipid,Lycopersicon esculentum,membrane lipid,Membrane Lipids,molecular interaction,monomer,nanoanalysis,nanoparticle,Nanoparticles,palmitic acid derivative,Palmitic Acids,pectin,Pectins,pH measurement,phase transition,plant cell,plant epidermis,protein aggregation,structure analysis,surface property,tomato,transmission electron microscopy,ultrastructure,ultraviolet spectrophotometry,unclassified drug}
}

@article{guzman-puyolSustainableBiobasedPolymers2022,
  title = {Sustainable Bio-Based Polymers: {{Towards}} a Circular Bioeconomy},
  author = {{Guzman-Puyol}, S. and Benítez, J.J. and {Heredia-Guerrero}, J.A.},
