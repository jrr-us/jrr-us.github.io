  title = {In Situ {{TEM}} and Synchrotron {{SAXS}}/{{WAXS}} Study on the Impact of Different Iron Salts on Iron-Catalysed Graphitization of Cellulose},
  author = {C.~Hayward, Emily and Takeguchi, Masaki and J.~Lloyd, Harry and M.~Stratford, Joshua and J.~Smith, Andrew and Snow, Tim and {Ramírez-Rico}, Joaquin and Schnepp, Zoe},
