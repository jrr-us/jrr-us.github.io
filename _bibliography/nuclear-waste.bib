@article{osunaTechnologicalApproachBased2023,
  title = {A Technological Approach Based on Engineered Nanoclay Composites for Cesium and Iodine Retention.},
  author = {Osuna, Francisco J. and Pavón, Esperanza and Alba, M. D.},
  year = 2023,
  journal = {Chemosphere},
  volume = {341},
  pages = {140128},
  issn = {0045-6535},
  doi = {10.1016/j.chemosphere.2023.140128},
  urldate = {2026-02-05},
  abstract = {The development of effective and environmentally friendly methods for separating hazardous radionuclides from waste poses a significant technological challenge. 137Cs and 131I are among the most important radionuclides discharged into the environment by nuclear power plants. One of the best ways to eliminate them involves adsorption on clay minerals. In this regard, studies have demonstrated that organofunctionalized clay minerals are effective adsorbents. Thus, this study investigates the capability of organofunctionalized synthetic design clay minerals to jointly eliminate cesium and iodine. The adsorbents studied are a range of organofunctionalized clay minerals with alkylammonium cations of different alkyl chain lengths (2, 3 and 18) and some physical mixtures of raw clay minerals and octadecylammonium compounds. Organofunctionalized synthetic swelling highly charged micas are effective adsorbents for the simultaneous adsorption of cesium and iodine. In addition, the optimal system is a mixture of Na-M4 with octadecylammonium (50\% w/w).},
  keywords = {adsorbent,adsorption,Adsorption,Alkyl chain lengths,alkyl group,alkylammonium,Alkylammonium cations,Article,cation,cation exchange,cesium,Cesium,clay,Clay,clay mineral,Clay minerals,composite,Design adsorbent,Design adsorbents,design method,energy dispersive X ray spectroscopy,environmental impact,Environmental impact,Fourier transform infrared spectroscopy,inductively coupled plasma mass spectrometry,iodine,Iodine,Iodine Radioisotopes,mica,Mica,nanoclay,Nanoclay composites,nanocomposite,Nanocomposites,nanoengineering,nanoparticle,Nuclear fuels,nuclear power plant,Nuclear power plants,octadecylammonium,Octadecylammonium,Organofunctionalized,Physical mixtures,physical parameters,quaternary ammonium derivative,radioactive iodine,radioactive waste,Radioactive waste,radioactive waste management,Radioactive wastes,Radioisotopes,Raw clay,scanning electron microscopy,swelling (physical),Synthesis (chemical),Synthetic design,Technological challenges,technological change,thermogravimetry,unclassified drug,X ray diffraction}
}

@article{pavonInsightRoleTemperature2022,
  title = {Insight into the Role of Temperature, Time and {{pH}} in the Effective Zirconium Retention Using Clay Minerals},
  author = {Pavón, Esperanza and Alba, María D.},
  year = 2022,
  journal = {Journal of Environmental Management},
  volume = {308},
  pages = {114635},
  issn = {0301-4797},
  doi = {10.1016/j.jenvman.2022.114635},
  urldate = {2026-02-05},
  abstract = {The use of zirconium in chemical industries generates a potential risk of Zr contamination in the environment, with particular concern for the decommissioning of uranium-graphite reactors. Among the natural adsorbents employed for the treatment of nuclear waste, clay minerals showed a very high affinity adsorption for radionuclides, but the influence of the chemical composition, pressure, temperature and time reaction have not yet been analysed on deep. Thus, the objective of this research is to explore several experimental conditions for an actual prediction of the behaviour of zirconium immobilization by clay minerals. The results have shown that factors such as zirconium cation nature (Zr4+ or ZrO2+), temperature, time and pH influence the extent of zirconium immobilization by clay minerals and the zirconium phases generated. At moderate conditions, zirconium tectosilicates are formed and evolve to zircon at high temperature and a longer time reaction.},
  keywords = {adsorption,Adsorption,aluminum silicate,Article,bentonite,Cam-clay model,chemical composition,clay,Clay,clay mineral,Clay minerals,contamination,decommissioning,deconvolution,experimental study,high temperature,Hydrogen-Ion Concentration,immobilization,mineral,Minerals,montmorillonite,pH,radioactive waste disposal,Radioactive waste disposal,radioisotope,room temperature,silicon dioxide,temperature,Temperature,temperature effect,Uranium,X ray diffraction,zircon,zirconium,Zirconium}
}

@article{martin-rodriguezExploringLocalEnvironment2022,
  title = {Exploring the Local Environment of the Engineered Nanoclay {{Mica-4}} under Hydrothermal Conditions Using {{Eu3}}+ as a Luminescent Probe},
  author = {{Martín-Rodríguez}, R. and Aguado, F. and Alba, M. D. and Valiente, R. and Pavón, E. and {Perdigon-Aller}, A.C.},
  year = 2022,
  journal = {Journal of Alloys and Compounds},
  volume = {921},
  doi = {10.1016/j.jallcom.2022.166086},
  abstract = {High charge mica Na{$<$}inf{$>$}4{$<$}/inf{$>$}Al{$<$}inf{$>$}4{$<$}/inf{$>$}Si{$<$}inf{$>$}4{$<$}/inf{$>$}Mg{$<$}inf{$>$}6{$<$}/inf{$>$}O{$<$}inf{$>$}20{$<$}/inf{$>$}F{$<$}inf{$>$}4{$<$}/inf{$>$}, Mica-4, is a promising candidate as a filling material to immobilize high-level radioactive waste in deep geological repositories due to its extraordinary adsorption capacity. In contrast to traditional clay materials, the structural composition of this mica, with a high content of aluminum in the tetrahedral sheet, enhances its chemical reactivity, favoring the formation of new crystalline phases under mild hydrothermal conditions, and thus providing a definitive isolation of the radionuclides in the engineered barrier. Moreover, this synthetic clay has some features that allow its use as an optical sensor by doping with luminescent rare earth cations such as Eu3+. In this paper we discuss the local structure of the nanoclay Mica-4 using Eu3+ as a local probe to track the physical and chemical modifications under hydrothermal conditions. For that purpose, a set of hydrothermal experiments has been carried out heating Mica-4 and an aqueous Eu(NO{$<$}inf{$>$}3{$<$}/inf{$>$}){$<$}inf{$>$}3{$<$}/inf{$>$} solution in a stainless steel reactor at different temperatures and times. Optical properties of the as-treated samples were characterized by spectroscopic measurements. The fine peak structure of emission and the relative intensity of different Eu3+ transitions as well as the luminescence lifetime have been correlated with the structure and composition of this nanoclay, and the interaction mechanisms between the lanthanide ions and the clay mineral at different temperatures and times. Special attention has been paid to understanding the role of the aluminum content, which may act as either an aggregating or dispersing agent, in the optical features and reactivity of the system. © 2022 The Authors},
  keywords = {Adsorption,Adsorption capacities,Aluminum,Chemical modification,Clay materials,Crystalline materials,Deep geological repository,Deep Geological Repository,Filling materials,Geology,High charge micas,High-charge mica,Highlevel radioactive wastes (HLW),Hydrothermal conditions,Local environments,Luminescence,Luminescent probes,Mica,Nano clays,Nanocomposites,Optical properties,Optical sensor,Optical sensors,Probes,Radioisotopes,Radionuclide,Rare earth elements,Rare earths}
}

@article{josegarcia-jimenezInfluenceTemperatureTime2016,
  title = {Influence of Temperature and Time on the {{Eu3}}+ Reaction with Synthetic {{Na-Mica-n}} (N=2 and 4)},
  author = {{José García-Jiménez}, M. and Cota, A. and Osuna, F.J. and Pavón, E. and Alba, M. D.},
  year = 2016,
  journal = {Chemical Engineering Journal},
  volume = {284},
  pages = {1174--1183},
  doi = {10.1016/j.cej.2015.09.077},
  abstract = {Bentonite is accepted as the best clay material for the engineered barrier of Deep Geological Repositories (DGRs). The performance of clay as the main component of the engineered barrier in the DGR has been intensively studied and the structure of the selected clay mineral play a crucial role. In this sense, a new family of synthetic swelling silicates, Na-Mica-n, with tuned layer charge (n) values between 2.0 and 4.0 per unit cell has recently been synthesized and a general synthetic method has been reported. These swelling high-charge micas could be highly valuable for the decontamination of harmful cations. The ability of these micas to immobilize Eu3+ under subcritical conditions has been probed. The adsorption was in both non-specific sites (cation exchange mechanism) and specific sites (chemical reaction or surface defects adsorption). Moreover, its adsorption capacity, under the same conditions is higher than in saponite and far superior to the bentonites. © 2015 Elsevier B.V.},
  keywords = {Adsorption,Adsorption capacities,Bentonite,Cation-exchange mechanism,Chemical reaction,Chemical reactions,Deep geological repository,Engineered barrier,Engineered barriers,Europium,High charge micas,Mica,Micas,Positive ions,Radioisotopes,Radionuclides,Silicate minerals,Silicates,Specific sites,Sub-critical condition,Surface defects,Surface reactions,Synthetic methods}
}
